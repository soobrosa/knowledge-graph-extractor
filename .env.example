# Get a free API key at https://jina.ai/api-key (used for URL-to-markdown via Jina Reader)
JINA_API_KEY=jina_xxxx

# --- Model / backend (scripts/mac-setup.sh + scripts/mac-run.sh; see docs/MAC.md) ---
# Both scripts source this file before applying their defaults, so anything set here wins.
