# Get a free API key at https://jina.ai/api-key (used for URL-to-markdown via Jina Reader)
JINA_API_KEY=jina_xxxx

# --- Model / backend (scripts/mac-setup.sh + scripts/mac-run.sh; see docs/MAC.md) ---
# Both scripts source this file before applying their defaults, so anything set here wins.
# BACKEND=dspark                    # dspark (default: mlx-dspark + Qwen3.8) | llamacpp | mlx
#
# --- dspark backend (BACKEND=dspark) ---
# DSPARK_MODEL=mlx-community/Qwen3.8-27B-4bit   # ~18GB peak; the 8-bit build needs 48GB+
# DSPARK_MODE=auto                  # auto|dspark|dflash|lookup|baseline (auto = measured best)
# DSPARK_KV_BITS=0                  # 4/8 = quantize target KV (pure-attention targets only;
#                                   # Qwen3.8-27B is hybrid linear-attention and rejects it)
# DSPARK_CTX=32768                  # server-side context window
# ENABLE_THINKING=1                 # default off: extraction wants facts, not reasoning
# MLX_DSPARK_BIN=/path/to/mlx-dspark  # override binary discovery
#
# --- llamacpp backend (BACKEND=llamacpp) ---
# MODEL_FILE=Qwen3.6-35B-A3B-UD-Q3_K_XL.gguf
# CTX_SIZE=16384
# SPEC_ARGS=--spec-type draft-mtp --spec-draft-n-max 3 --spec-draft-p-min 0.1
# HF_TOKEN=hf_xxxx                  # optional: faster, unthrottled model download
